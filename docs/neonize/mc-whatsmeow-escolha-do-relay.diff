+// relayDoChamadorSemFNA devolve, numa oferta recebida sem endpoint is_fna, o endpoint nao proprio
+// (auth_token_id == 0) de menor c2r_rtt, ou nil se nao ha candidato. TeleZapp (meowcaller#40).
+func relayDoChamadorSemFNA(rd *relayData) *relayEndpoint {
+	for i := range rd.endpoints {
+		if rd.endpoints[i].isFNA {
+			return nil
+		}
+	}
+	var melhor *relayEndpoint
+	for i := range rd.endpoints {
+		e := &rd.endpoints[i]
+		if e.authTokenID != 0 || e.c2rRTT == 0 {
+			continue
+		}
+		if melhor == nil || e.c2rRTT < melhor.c2rRTT {
+			melhor = e
+		}
+	}
+	return melhor
+}
+
+// descreverRelaysDaOferta resume os endpoints da oferta para o log (nunca enderecos nem tokens):
+// nome, is_fna, token_id, auth_token_id e c2r_rtt. TeleZapp.
+func descreverRelaysDaOferta(rd *relayData) string {
+	partes := make([]string, 0, len(rd.endpoints))
+	for _, e := range rd.endpoints {
+		partes = append(partes, fmt.Sprintf("%s(fna=%v tok=%d auth=%d rtt=%d)", e.relayName, e.isFNA, e.tokenID, e.authTokenID, e.c2rRTT))
+	}
+	return strings.Join(partes, " ")
+}
+
 // logControleDaChamada registra o nome e os atributos (nunca o conteudo) de uma mensagem de
