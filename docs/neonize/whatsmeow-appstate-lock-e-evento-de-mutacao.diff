+// AppStateMutation is emitted for every app state mutation, set or remove, with the
+// collection it came from and its version. Unlike AppState it is also emitted during a
+// full sync (except for the contacts a full sync stores in bulk), so a client can keep
+// its own copy of the entries whatsmeow has no event for (labels, status privacy...).
+type AppStateMutation struct {
+	Name         appstate.WAPatchName
+	Index        []string
+	Version      int32
+	Remove       bool
+	Action       *waSyncAction.SyncActionValue
+	FromFullSync bool
+}
