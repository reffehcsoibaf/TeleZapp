+// Every app state mutation, set or remove (Remove), with its collection
+// (Name) and Version, also during a full sync. For the entries no other event
+// carries: "keep chats archived", labels and lists, status privacy...
+message AppStateMutation { //57
+    required string Name = 1;
+    repeated string Index = 2;
+    required int32 Version = 3;
+    required bool Remove = 4;
+    optional WAWebProtobufSyncAction.SyncActionValue Action = 5;
+    required bool FromFullSync = 6;
+}
 message UpdateGroupParticipantsReturnFunction {
     optional string Error = 1;
     repeated GroupParticipant participants = 2;
