+// candidatosDeRelay lista os relays da oferta na ordem em que a midia de uma chamada recebida deve
+// tentar: primeiro o que getMediaRelayEndpoint escolhe, depois os outros por (nao proprio antes do
+// proprio, menor c2r_rtt antes do maior, sem rtt por ultimo). Sem repeticao. TeleZapp: plano B das
+// chamadas recebidas sem som (meowcaller#40, #37): se o relay escolhido nao traz a midia do outro
+// lado, o proximo e tentado.
+func candidatosDeRelay(rd *relayData, inbound bool) []*relayEndpoint {
+	var saida []*relayEndpoint
+	visto := map[*relayEndpoint]bool{}
+	if e := getMediaRelayEndpoint(rd, inbound); e != nil {
+		saida = append(saida, e)
+		visto[e] = true
+	}
+	var outros []*relayEndpoint
+	for i := range rd.endpoints {
+		e := &rd.endpoints[i]
+		if !visto[e] && len(e.addresses) > 0 {
+			outros = append(outros, e)
+		}
+	}
+	sort.SliceStable(outros, func(a, b int) bool {
+		ea, eb := outros[a], outros[b]
+		if (ea.authTokenID == 0) != (eb.authTokenID == 0) {
+			return ea.authTokenID == 0
+		}
+		if (ea.c2rRTT == 0) != (eb.c2rRTT == 0) {
+			return ea.c2rRTT != 0
+		}
+		return ea.c2rRTT < eb.c2rRTT
+	})
+	return append(saida, outros...)
+}
