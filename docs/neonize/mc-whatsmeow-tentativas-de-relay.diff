+package meowcaller
+
+import (
+	"context"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// janelaSemMidiaDoPar e quanto se espera, em cada relay, por algo autenticado do outro lado (SRTCP ou
+// audio) antes de tentar o proximo. Numa chamada que funciona o primeiro SRTCP chega em ~1,5 s.
+var janelaSemMidiaDoPar = 5 * time.Second
+
+// rodadasDeRelays e quantas vezes a lista de relays e percorrida antes de ficar no ultimo.
+const rodadasDeRelays = 2
+
+// runMediaComTentativas e o plano B das chamadas recebidas sem som: numa chamada 1:1 recebida com mais
+// de um relay na oferta, se o relay escolhido nao traz nada autenticado do outro lado em
+// janelaSemMidiaDoPar (contada a partir do momento em que a chamada foi atendida), derruba a midia e
+// tenta o proximo (candidatosDeRelay), dando voltas na lista. Chamada de saida e de grupo seguem o
+// caminho de sempre. TeleZapp.
+func (e *engine) runMediaComTentativas(ctx context.Context, callID string, call *Call, callKey []byte, selfLID, peerLID string, rd *relayData, inbound, grupo bool) error {
+	return e.tentarRelays(ctx, callID, inbound, grupo, rd, func(c context.Context, ep *relayEndpoint, par func()) error {
+		return e.runMedia(c, callID, call, callKey, selfLID, peerLID, rd, inbound, ep, par)
+	})
+}
+
+// prazoDaTentativa devolve quando a tentativa que comecou em `inicio` deve estourar: janelaSemMidiaDoPar
+// depois do mais tardio entre o comeco dela e o atendimento da chamada. Zero enquanto a chamada nao foi
+// atendida (o outro lado so manda midia depois disso).
+func (e *engine) prazoDaTentativa(callID string, inicio time.Time) time.Time {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	m := e.calls[callID]
+	if m == nil || m.acceptPending || m.aceitoEm.IsZero() {
+		return time.Time{}
+	}
+	base := inicio
+	if m.aceitoEm.After(base) {
+		base = m.aceitoEm
+	}
+	return base.Add(janelaSemMidiaDoPar)
+}
+
+func (e *engine) tentarRelays(ctx context.Context, callID string, inbound, grupo bool, rd *relayData, rodar func(context.Context, *relayEndpoint, func()) error) error {
+	cands := candidatosDeRelay(rd, inbound)
+	if !inbound || grupo || len(cands) < 2 {
+		return rodar(ctx, nil, nil)
+	}
+	total := rodadasDeRelays * len(cands)
+	for n := 0; n < total; n++ {
+		ep := cands[n%len(cands)]
+		ultimo := n == total-1
+		tctx, cancel := context.WithCancel(ctx)
+		var uma sync.Once
+		par := make(chan struct{})
+		var estourou atomic.Bool
+		inicio := time.Now()
+		if !ultimo {
+			go func(ep *relayEndpoint) {
+				tick := time.NewTicker(100 * time.Millisecond)
+				defer tick.Stop()
+				for {
+					select {
+					case <-par:
+						return
+					case <-tctx.Done():
+						return
+					case <-tick.C:
+					}
+					if prazo := e.prazoDaTentativa(callID, inicio); !prazo.IsZero() && time.Now().After(prazo) {
+						estourou.Store(true)
+						e.c.log.Warn().Str("call_id", callID).Str("relay", ep.relayName).
+							Msg("TeleZapp: nada do outro lado neste relay; tentando o proximo")
+						cancel()
+						return
+					}
+				}
+			}(ep)
+		}
+		e.c.log.Info().Str("call_id", callID).Str("relay", ep.relayName).Int("tentativa", n+1).
+			Int("de", total).Msg("TeleZapp: midia no relay")
+		usado := ep
+		if n == 0 && os.Getenv("TELEZAPP_FORCAR_TENTATIVA") == "1" {
+			// so para testar o plano B: a primeira tentativa vai a um endereco que nao responde
+			falso := *ep
+			falso.addresses = []relayAddress{{ipv4: "192.0.2.1", port: 3478}}
+			usado = &falso
+			e.c.log.Warn().Str("call_id", callID).Msg("TeleZapp: TELEZAPP_FORCAR_TENTATIVA ligado; 1a tentativa num endereco que nao responde")
+		}
+		err := rodar(tctx, usado, func() { uma.Do(func() { close(par) }) })
+		cancel()
+		if !estourou.Load() {
+			return err
+		}
+		// a proxima tentativa monta tudo de novo: solta o que a anterior deixou na chamada
+		e.mu.Lock()
+		if m := e.calls[callID]; m != nil {
+			old := m.groupReceivers
+			m.groupReceivers = nil
+			e.mu.Unlock()
+			if old != nil {
+				old.clear()
+			}
+		} else {
+			e.mu.Unlock()
+			return err
+		}
+	}
+	return nil
+}
