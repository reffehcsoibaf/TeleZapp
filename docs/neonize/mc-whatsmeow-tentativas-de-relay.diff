+package meowcaller
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/rs/zerolog"
+)
+
+func relaysDeAndroid() *relayData {
+	return &relayData{endpoints: []relayEndpoint{
+		{relayName: "gru1c02", tokenID: 0, c2rRTT: 0, addresses: []relayAddress{{ipv4: "1.1.1.1", port: 1}}},
+		{relayName: "bsb1c01", tokenID: 1, c2rRTT: 0, addresses: []relayAddress{{ipv4: "2.2.2.2", port: 2}}},
+		{relayName: "poa1c01", tokenID: 2, c2rRTT: 8, addresses: []relayAddress{{ipv4: "3.3.3.3", port: 3}}},
+	}}
+}
+
+func TestCandidatosDeRelayComecaPeloEscolhidoESegueOutros(t *testing.T) {
+	rd := relaysDeAndroid()
+	cands := candidatosDeRelay(rd, true)
+	if len(cands) != 3 {
+		t.Fatalf("quis 3 candidatos, vieram %d", len(cands))
+	}
+	if cands[0] != getMediaRelayEndpoint(rd, true) {
+		t.Fatalf("o primeiro deve ser o que o caminho de sempre escolhe, veio %s", cands[0].relayName)
+	}
+	vistos := map[string]bool{}
+	for _, c := range cands {
+		if vistos[c.relayName] {
+			t.Fatalf("relay repetido: %s", c.relayName)
+		}
+		vistos[c.relayName] = true
+	}
+	// com rtt, o de menor rtt e o primeiro (relayDoChamadorSemFNA); os sem rtt seguem na ordem da oferta
+	if cands[0].relayName != "poa1c01" || cands[1].relayName != "gru1c02" || cands[2].relayName != "bsb1c01" {
+		t.Fatalf("ordem inesperada: %s %s %s", cands[0].relayName, cands[1].relayName, cands[2].relayName)
+	}
+	// oferta do Android do WinZapp (sem rtt): o primeiro nao proprio, depois o outro
+	sem := &relayData{endpoints: []relayEndpoint{
+		{relayName: "gru1c02", tokenID: 0, addresses: []relayAddress{{ipv4: "1.1.1.1", port: 1}}},
+		{relayName: "bsb1c01", tokenID: 1, addresses: []relayAddress{{ipv4: "2.2.2.2", port: 2}}},
+	}}
+	c2 := candidatosDeRelay(sem, true)
+	if len(c2) != 2 || c2[0].relayName != "gru1c02" || c2[1].relayName != "bsb1c01" {
+		t.Fatalf("oferta sem rtt: ordem inesperada %v", c2)
+	}
+}
+
+func engineDeTeste() *engine {
+	client := &Client{log: zerolog.Nop()}
+	eng := &engine{c: client, calls: make(map[string]*engineCall)}
+	client.eng = eng
+	eng.calls["c1"] = &engineCall{aceitoEm: time.Now()}
+	return eng
+}
+
+func TestTentarRelaysPulaParaOProximoQuandoNaoChegaNada(t *testing.T) {
+	antes := janelaSemMidiaDoPar
+	janelaSemMidiaDoPar = 80 * time.Millisecond
+	defer func() { janelaSemMidiaDoPar = antes }()
+	eng := engineDeTeste()
+	var usados []string
+	err := eng.tentarRelays(context.Background(), "c1", true, false, relaysDeAndroid(),
+		func(ctx context.Context, ep *relayEndpoint, par func()) error {
+			usados = append(usados, ep.relayName)
+			if len(usados) == 2 { // o segundo relay "traz" o outro lado
+				par()
+				return nil
+			}
+			<-ctx.Done()
+			return ctx.Err()
+		})
+	if err != nil {
+		t.Fatalf("erro inesperado: %v", err)
+	}
+	if len(usados) != 2 {
+		t.Fatalf("quis 2 tentativas, foram %d: %v", len(usados), usados)
+	}
+}
+
+func TestTentarRelaysNaoMexeEmSaidaNemGrupoNemRelayUnico(t *testing.T) {
+	eng := engineDeTeste()
+	for _, c := range []struct {
+		inbound, grupo bool
+		rd             *relayData
+	}{
+		{false, false, relaysDeAndroid()},
+		{true, true, relaysDeAndroid()},
+		{true, false, &relayData{endpoints: relaysDeAndroid().endpoints[:1]}},
+	} {
+		chamadas := 0
+		_ = eng.tentarRelays(context.Background(), "c1", c.inbound, c.grupo, c.rd,
+			func(ctx context.Context, ep *relayEndpoint, par func()) error {
+				chamadas++
+				if ep != nil || par != nil {
+					t.Fatalf("o caminho de sempre nao recebe relay forcado")
+				}
+				return nil
+			})
+		if chamadas != 1 {
+			t.Fatalf("quis uma execucao so, foram %d", chamadas)
+		}
+	}
+}
+
+func TestTentarRelaysNaoReexecutaSeAChamadaTerminaEmVezDeEstourar(t *testing.T) {
+	antes := janelaSemMidiaDoPar
+	janelaSemMidiaDoPar = time.Second
+	defer func() { janelaSemMidiaDoPar = antes }()
+	eng := engineDeTeste()
+	ctx, cancel := context.WithCancel(context.Background())
+	chamadas := 0
+	_ = eng.tentarRelays(ctx, "c1", true, false, relaysDeAndroid(),
+		func(c context.Context, ep *relayEndpoint, par func()) error {
+			chamadas++
+			cancel() // a chamada acabou antes do prazo
+			<-c.Done()
+			return c.Err()
+		})
+	if chamadas != 1 {
+		t.Fatalf("a chamada acabou: nao tenta outro relay (foram %d)", chamadas)
+	}
+}
+
+func TestTentarRelaysDaVoltasNaListaAteAcertar(t *testing.T) {
+	antes := janelaSemMidiaDoPar
+	janelaSemMidiaDoPar = 60 * time.Millisecond
+	defer func() { janelaSemMidiaDoPar = antes }()
+	eng := engineDeTeste()
+	rd := &relayData{endpoints: relaysDeAndroid().endpoints[:2]} // 2 relays
+	var usados []string
+	err := eng.tentarRelays(context.Background(), "c1", true, false, rd,
+		func(ctx context.Context, ep *relayEndpoint, par func()) error {
+			usados = append(usados, ep.relayName)
+			if len(usados) == 3 { // na volta, o primeiro relay funciona
+				par()
+				return nil
+			}
+			<-ctx.Done()
+			return ctx.Err()
+		})
+	if err != nil {
+		t.Fatalf("erro inesperado: %v", err)
+	}
+	if len(usados) != 3 || usados[0] != usados[2] || usados[0] == usados[1] {
+		t.Fatalf("quis relay A, B, A; foi %v", usados)
+	}
+}
+
+func TestTentarRelaysSoContaOPrazoDepoisDeAtender(t *testing.T) {
+	antes := janelaSemMidiaDoPar
+	janelaSemMidiaDoPar = 50 * time.Millisecond
+	defer func() { janelaSemMidiaDoPar = antes }()
+	eng := engineDeTeste()
+	eng.calls["c1"].aceitoEm = time.Time{} // ainda tocando
+	chamadas := 0
+	ctx, cancel := context.WithTimeout(context.Background(), 400*time.Millisecond)
+	defer cancel()
+	_ = eng.tentarRelays(ctx, "c1", true, false, relaysDeAndroid(),
+		func(c context.Context, ep *relayEndpoint, par func()) error {
+			chamadas++
+			<-c.Done()
+			return c.Err()
+		})
+	if chamadas != 1 {
+		t.Fatalf("antes de atender nao troca de relay (foram %d tentativas)", chamadas)
+	}
+}
--- engine_media.go (acrescimo: soltar o Recv ao cancelar)
+++ engine_media.go
@@ func (e *engine) runMedia(...)
-	defer ch.Close()
+	// TeleZapp: o Recv abaixo bloqueia e nao olha o contexto; ao cancelar (plano B das tentativas de
+	// relay, ou fim da chamada) o canal e fechado para soltar o Recv. O Once evita fechar duas vezes.
+	fimDoLaco := make(chan struct{})
+	var fecharCanal sync.Once
+	fechaCanal := func() { fecharCanal.Do(func() { _ = ch.Close() }) }
+	defer func() { close(fimDoLaco); fechaCanal() }()
+	go func() { select { case <-ctx.Done(): fechaCanal(); case <-fimDoLaco: } }()
