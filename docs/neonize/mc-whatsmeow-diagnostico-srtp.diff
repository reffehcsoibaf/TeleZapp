+
+// logControleDaChamada registra o nome e os atributos (nunca o conteudo) de uma mensagem de
+// controle da chamada. Os atributos de chave de criptografia nao existem aqui: a chave viaja
+// cifrada nos filhos, que nao sao lidos. TeleZapp.
+func (e *engine) logControleDaChamada(callNode *waBinary.Node, filho waBinary.Node) {
+	attrs := make([]string, 0, len(filho.Attrs))
+	for k, v := range filho.Attrs {
+		attrs = append(attrs, fmt.Sprintf("%s=%v", k, v))
+	}
+	sort.Strings(attrs)
+	e.c.log.Info().Str("controle", filho.Tag).
+		Str("atributos", strings.Join(attrs, " ")).
+		Int("filhos", len(filho.GetChildren())).
+		Msg("controle da chamada recebido: " + filho.Tag) // a mensagem entra na chave de repeticao do log
+}
