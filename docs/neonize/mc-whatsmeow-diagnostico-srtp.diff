+
+// logUnprotectDiag registra, so para os dois primeiros pacotes de audio que nao autenticaram, o
+// que o diferencia de um pacote normal: tamanho, tipo, marcador, palavra de extensao, e se ele
+// autenticaria com outro tamanho de etiqueta ou outro ROC (o que apontaria para o formato do
+// pacote, e nao para uma troca de chave). Chamado com recvMu travado. TeleZapp.
+func (p *MediaPipeline) logUnprotectDiag(packet []byte, header rtp.RtpHeader, roc uint32, n int64) {
+	ext := byte(0)
+	cc := byte(0)
+	if len(packet) > 0 {
+		ext = (packet[0] >> 4) & 1
+		cc = packet[0] & 0x0f
+	}
+	ev := p.log.Warn().Int64("falha_n", n).Int("packet_bytes", len(packet)).
+		Uint32("ssrc", header.Ssrc).Uint16("seq", header.SequenceNumber).
+		Uint8("payload_type", header.PayloadType).Bool("marker", header.Marker).
+		Uint8("flag_extensao", ext).Uint8("csrc_count", cc).
+		Bool("palavra_extensao", header.ExtensionWord != nil).
+		Bool("extensao_video", header.VideoExtension != nil).
+		Uint32("ultima_seq_boa", p.lastGoodSeq.Load()).
+		Int64("autenticados_antes", p.unprotectOK.Load()).
+		Int("tag_len_usado", p.warpMITagLen)
+	var achou []int
+	for tl := 1; tl <= sha1.Size; tl++ {
+		if len(packet) < 12+tl {
+			break
+		}
+		semTag := packet[:len(packet)-tl]
+		tag := packet[len(packet)-tl:]
+		for _, r := range []uint32{roc, roc + 1, roc + 2} {
+			if srtp.VerifyWarpMITag(p.recvKeys.AuthKey[:], semTag, r, tl, tag, p.log) {
+				achou = append(achou, tl*10+int(r-roc))
+			}
+		}
+	}
+	ev.Ints("tag_len_que_autentica_x10_mais_delta_roc", achou).Msg("unprotect: diagnostico do pacote que falhou")
+}
