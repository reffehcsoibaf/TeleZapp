+
+// dismissOtherDevices (TeleZapp) manda parar de tocar nos aparelhos do outro lado que nao
+// decidiram: um <terminate reason=...> por aparelho (accepted_elsewhere ou
+// rejected_elsewhere), como o WhatsApp Web e o APK (quem atende ou recusa nao avisa os
+// proprios aparelhos). So uma vez por chamada. Todos os
+// aparelhos sao da mesma pessoa, entao o numero do aparelho basta para achar quem atendeu
+// (o endereco do aceite pode vir como LID ou telefone).
+func (e *engine) dismissOtherDevices(callID string, answerer types.JID, reason string) {
+	if answerer.IsEmpty() {
+		return
+	}
+	e.mu.Lock()
+	m := e.calls[callID]
+	if m == nil {
+		e.mu.Unlock()
+		return
+	}
+	devices, creator := m.ringingDevices, m.creator
+	m.ringingDevices = nil
+	e.mu.Unlock()
+
+	for _, device := range devices {
+		if device.Device == answerer.Device {
+			continue
+		}
+		term := signaling.BuildTerminate(&signaling.TerminateParams{
+			CallID: callID, To: device, CallCreator: creator, Reason: &reason,
+		})
+		term.Attrs["id"] = e.nextCallNodeID()
+		if err := e.transmitCallNode(context.Background(), term); err != nil {
+			e.c.log.Warn().Err(err).Str("call_id", callID).Str("device", device.String()).Msg("dismiss other device failed")
+			continue
+		}
+		e.c.log.Info().Str("call_id", callID).Str("device", device.String()).Msg("told other device to stop ringing")
+	}
 }
 
