diff --git a/audio_codec_runtime.go b/audio_codec_runtime.go
new file mode 100644
index 0000000..82781d2
--- /dev/null
+++ b/audio_codec_runtime.go
@@ -0,0 +1,64 @@
+package meowcaller
+
+import (
+	"sync"
+	"time"
+)
+
+// Settings can arrive in accept AFTER relay media has started. Both directions
+// reconcile the authoritative setting at packet boundaries, under one mutex.
+// No publication hook can miss an update between startup and peer acceptance.
+// SRTP pipes and sequence/ROC state survive; only codec/order state is replaced.
+type callAudioRuntime struct {
+	mu        sync.Mutex
+	codec     AudioCodec
+	encoder   callAudioEncoder
+	current   func() AudioCodec
+	receivers *participantReceiveRegistry
+	sender    *MediaPipeline
+}
+
+func (a *callAudioRuntime) refreshLocked() error {
+	codec := a.current()
+	if codec == a.codec {
+		return nil
+	}
+	encoder, err := newCallAudioEncoder(codec)
+	if err != nil {
+		return err
+	}
+	a.receivers.configureAudioCodec(codec)
+	a.sender.setAudioTimestampStride(audioRTPClock(codec) * 60 / 1000)
+	a.codec, a.encoder = codec, encoder
+	return nil
+}
+
+func (a *callAudioRuntime) Protect(frame []float32) ([]byte, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if err := a.refreshLocked(); err != nil {
+		return nil, err
+	}
+	payload, err := a.encoder.Encode(frame)
+	if err != nil {
+		return nil, err
+	}
+	return a.sender.ProtectAudio(payload)
+}
+
+func (a *callAudioRuntime) Receive(packet []byte, now time.Time) ([]decodedParticipantAudio, bool, uint32, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if err := a.refreshLocked(); err != nil {
+		return nil, false, 0, err
+	}
+	clock := audioRTPClock(a.codec)
+	frames, ok := a.receivers.ReceiveAudio(packet, clock, now)
+	return frames, ok, clock, nil
+}
+
+func (p *MediaPipeline) setAudioTimestampStride(samples uint32) {
+	p.sendMu.Lock()
+	defer p.sendMu.Unlock()
+	p.stream.SetAudioTimestampStride(samples)
+}
