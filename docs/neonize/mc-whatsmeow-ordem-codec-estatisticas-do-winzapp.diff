new file mode 100644
index 0000000..0bb0da7
--- /dev/null
+++ b/audio_codec_runtime_test.go
@@ -0,0 +1,73 @@
+package meowcaller
+
+import (
+	"bytes"
+	"github.com/purpshell/meowcaller/rtp"
+	"testing"
+	"time"
+)
+
+func TestLateCallCodecSettingsReconfigureBothDirectionsWithoutRekey(t *testing.T) {
+	self, peer := mediaTestJID("100", 1), mediaTestJID("200", 2)
+	key := bytes.Repeat([]byte{7}, 32)
+	registry, err := newParticipantReceiveRegistry("CID", key, self.String(), peer.String(), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer registry.clear()
+	registry.configureAudioCodec(AudioCodecMlow)
+	selfSSRC, _ := rtp.DeriveWasmParticipantSsrc("CID", rtp.FormatE2ESrtpParticipantID(self.String()), 0)
+	peerSSRC, _ := rtp.DeriveWasmParticipantSsrc("CID", rtp.FormatE2ESrtpParticipantID(peer.String()), 0)
+	sender, _ := NewMediaPipeline(key, self.String(), peer.String(), selfSSRC, FrameSamples)
+	remote, _ := NewMediaPipeline(key, peer.String(), self.String(), peerSSRC, FrameSamples)
+	codec := AudioCodecMlow
+	encoder, _ := newCallAudioEncoder(codec)
+	audio := &callAudioRuntime{codec: codec, encoder: encoder, receivers: registry, sender: sender, current: func() AudioCodec { return codec }}
+	frame := make([]float32, FrameSamples)
+	var lastSequence uint16
+	for phase, want := range []AudioCodec{AudioCodecMlow, AudioCodecOpus, AudioCodecMlow} {
+		// This is the field onAccept/applyVoipSettingsCodec updates after relay
+		// startup; no new media loop or callback publication is needed.
+		codec = want
+		first, err := audio.Protect(frame)
+		if err != nil {
+			t.Fatal(err)
+		}
+		second, err := audio.Protect(frame)
+		if err != nil {
+			t.Fatal(err)
+		}
+		h1, _ := rtp.ParseRtpHeader(first)
+		h2, _ := rtp.ParseRtpHeader(second)
+		if h2.Timestamp-h1.Timestamp != audioRTPClock(want)*60/1000 {
+			t.Fatal("late setting left old RTP clock")
+		}
+		if phase > 0 && h1.SequenceNumber != lastSequence+1 {
+			t.Fatal("codec switch reset RTP sequence/ROC")
+		}
+		lastSequence = h2.SequenceNumber
+		for _, packet := range [][]byte{first, second} {
+			_, payload, ok := remote.UnprotectAudio(packet)
+			if !ok || len(newCallAudioDecoder(want).Decode(payload)) != FrameSamples {
+				t.Fatal("outgoing codec or SRTP mismatch")
+			}
+		}
+		peerEncoder, err := newCallAudioEncoder(want)
+		if err != nil {
+			t.Fatal(err)
+		}
+		payload, err := peerEncoder.Encode(frame)
+		if err != nil {
+			t.Fatal(err)
+		}
+		remote.setAudioTimestampStride(audioRTPClock(want) * 60 / 1000)
+		packet, err := remote.ProtectAudio(payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		pcm, ok, clock, err := audio.Receive(packet, time.Unix(int64(phase), 0))
+		if err != nil || !ok || clock != audioRTPClock(want) || len(pcm) != 1 || len(pcm[0].PCM) != FrameSamples {
+			t.Fatalf("late receive setting: codec=%s frames=%d clock=%d err=%v", want, len(pcm), clock, err)
+		}
+	}
+}
