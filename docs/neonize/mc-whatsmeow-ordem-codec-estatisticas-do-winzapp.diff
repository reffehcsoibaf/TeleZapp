@@ -0,0 +1,71 @@
+package meowcaller
+
+import (
+	"bytes"
+	"github.com/purpshell/meowcaller/rtp"
+	"testing"
+	"time"
+)
+
+func TestReceiveAudioAuthenticatesBeforeReorderAndCodecState(t *testing.T) {
+	self, peer := mediaTestJID("100", 1), mediaTestJID("200", 2)
+	key := bytes.Repeat([]byte{7}, 32)
+	decoder := &recordingParticipantDecoder{}
+	registry, err := newParticipantReceiveRegistry("CID", key, self.String(), peer.String(), func() participantAudioDecoder { return decoder })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer registry.clear()
+	ssrc, _ := rtp.DeriveWasmParticipantSsrc("CID", rtp.FormatE2ESrtpParticipantID(peer.String()), 0)
+	tx, err := NewMediaPipeline(key, peer.String(), self.String(), ssrc, 2880)
+	if err != nil {
+		t.Fatal(err)
+	}
+	packet := func(seq uint16) []byte {
+		got, err := tx.ProtectRTP(&rtp.RtpHeader{Ssrc: ssrc, SequenceNumber: seq, Timestamp: uint32(seq) * 2880, PayloadType: 120}, []byte{byte(seq)})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return got
+	}
+	now := time.Unix(0, 0)
+	p1, p2, p3 := packet(1), packet(2), packet(3)
+	forged := append([]byte(nil), p1...)
+	forged[len(forged)-1] ^= 1
+	if _, ok := registry.ReceiveAudio(forged, 48000, now); ok || len(decoder.payloads) != 0 {
+		t.Fatal("unauthenticated packet reached codec")
+	}
+	if got, ok := registry.ReceiveAudio(p1, 48000, now); !ok || len(got) != 1 {
+		t.Fatal("first authenticated frame lost")
+	}
+	if got, _ := registry.ReceiveAudio(p3, 48000, now); len(got) != 0 {
+		t.Fatal("stateful decode ran out of order")
+	}
+	got, ok := registry.ReceiveAudio(p2, 48000, now.Add(time.Millisecond))
+	if !ok || len(got) != 2 || got[0].Timestamp != 960 || got[1].Timestamp != 1920 {
+		t.Fatalf("wrong normalized clock/order: %+v", got)
+	}
+	registry.ReceiveAudio(p2, 48000, now)
+	if len(decoder.payloads) != 3 || decoder.payloads[1][0] != 2 {
+		t.Fatal("duplicate or out of order decode")
+	}
+}
+
+func TestConfigureCodecCoversExistingAndFutureGroupReceivers(t *testing.T) {
