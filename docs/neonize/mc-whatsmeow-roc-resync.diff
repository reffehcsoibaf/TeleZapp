+// Snapshot devolve o estado do estimador (para o log): ROC, maior sequencia vista e
+// se ja foi iniciado.
+func (t *RecvRocTracker) Snapshot() (uint32, uint16, bool) {
+	return t.roc, t.sL, t.initialized
+}
+
+// Resync fixa o ROC e a sequencia a partir de um pacote que passou na autenticacao
+// com um ROC diferente do estimado (perda grande, reinicio de sequencia).
+func (t *RecvRocTracker) Resync(roc uint32, seq uint16) {
+	t.roc, t.sL, t.initialized = roc, seq, true
+}
